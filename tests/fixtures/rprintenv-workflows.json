    {
      "id": "compare_explicit_sources",
      "binary": "rprintenv",
      "args": [
        "--env",
        "--file",
        ".env",
        "--file",
        ".env.local",
        "--json",
        "API_KEY"
      ],
      "environment": {
        "API_KEY": "synthetic-secret-lilac-48"
      },
      "files": {
        ".env": "API_KEY=synthetic-secret-lilac-48\n",
        ".env.local": "API_KEY=synthetic-secret-cobalt-73\n"
      },
      "stdin_utf8": "",
      "expect": {
        "exit_code": 0,
        "stdout_json": {
          "schema_version": 1,
          "records": [
            {
              "source": {
                "kind": "environment"
              },
              "name": "API_KEY",
              "state": "redacted",
              "value": null,
              "fingerprint": "1d5a8919184510ff"
            },
            {
              "source": {
                "kind": "file",
                "path": ".env"
              },
              "name": "API_KEY",
              "state": "redacted",
              "value": null,
              "fingerprint": "1d5a8919184510ff"
            },
            {
              "source": {
                "kind": "file",
                "path": ".env.local"
              },
              "name": "API_KEY",
              "state": "redacted",
              "value": null,
